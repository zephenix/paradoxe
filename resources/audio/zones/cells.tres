[gd_resource type="Resource" script_class="AcousticZone" format=3]

[ext_resource type="Script" path="res://scripts/audio/acoustic_zone.gd" id="1_zone"]

[resource]
script = ExtResource("1_zone")
id = &"cells"
title = "Cellules"
layers = Array[StringName]([&"amb_shaft_loop"])
layer_volumes_db = Array[float]([-4.0])
swell_depth_db = 2.0
swell_period = 15.0
events = Array[StringName]([&"amb_drip", &"amb_chain", &"amb_creak"])
event_interval_min = 3.5
event_interval_max = 9.0
event_distance_min = 200.0
event_distance_max = 900.0
event_volume_db = -3.0
reverb_wet = 0.14
reverb_room_size = 0.45
reverb_damping = 0.55
lowpass_hz = 20500.0
