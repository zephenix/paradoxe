[gd_resource type="Resource" script_class="AcousticZone" format=3]

[ext_resource type="Script" path="res://scripts/audio/acoustic_zone.gd" id="1_zone"]

[resource]
script = ExtResource("1_zone")
id = &"hall"
title = "Grand hall"
layers = Array[StringName]([&"amb_hall_loop", &"amb_electric_loop"])
layer_volumes_db = Array[float]([0.0, -12.0])
swell_depth_db = 3.0
swell_period = 24.0
events = Array[StringName]([&"amb_creak", &"amb_cry", &"amb_buzz"])
event_interval_min = 6.0
event_interval_max = 14.0
event_distance_min = 500.0
event_distance_max = 1600.0
event_volume_db = -4.0
reverb_wet = 0.5
reverb_room_size = 0.95
reverb_damping = 0.35
lowpass_hz = 20500.0
