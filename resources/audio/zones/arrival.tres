[gd_resource type="Resource" script_class="AcousticZone" format=3]

[ext_resource type="Script" path="res://scripts/audio/acoustic_zone.gd" id="1_zone"]

[resource]
script = ExtResource("1_zone")
id = &"arrival"
title = "Arrivée : ville en ruine, jungle"
layers = Array[StringName]([&"amb_jungle_loop", &"amb_wind_loop"])
layer_volumes_db = Array[float]([-2.0, -4.0])
swell_depth_db = 3.0
swell_period = 17.0
events = Array[StringName]([&"amb_cry", &"amb_debris", &"amb_creak"])
event_interval_min = 4.0
event_interval_max = 10.0
event_distance_min = 500.0
event_distance_max = 1500.0
event_volume_db = -3.0
reverb_wet = 0.05
reverb_room_size = 0.35
reverb_damping = 0.7
lowpass_hz = 20500.0
