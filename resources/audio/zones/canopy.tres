[gd_resource type="Resource" script_class="AcousticZone" format=3]

[ext_resource type="Script" path="res://scripts/audio/acoustic_zone.gd" id="1_zone"]

[resource]
script = ExtResource("1_zone")
id = &"canopy"
title = "Canopée : dans les hauteurs"
layers = Array[StringName]([&"amb_wind_loop", &"amb_jungle_loop"])
layer_volumes_db = Array[float]([2.0, -8.0])
swell_depth_db = 5.0
swell_period = 13.0
events = Array[StringName]([&"amb_creak", &"amb_debris", &"amb_cry"])
event_interval_min = 3.0
event_interval_max = 8.0
event_distance_min = 300.0
event_distance_max = 1200.0
event_volume_db = -2.0
reverb_wet = 0.03
reverb_room_size = 0.25
reverb_damping = 0.75
lowpass_hz = 20500.0
